generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  displayName           String?
  status                UserStatus             @default(INVITED)
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditEvents           AuditEvent[]           @relation("AuditActor")
  accounts              AuthAccount[]
  sessions              AuthSession[]
  mcpTokens             McpAccessToken[]
  mcpAuthorizationCodes McpAuthorizationCode[]
  mcpRefreshTokens      McpRefreshToken[]
  mcpScopes             McpUserScopeGrant[]
  roles                 UserRole[]
}

model AuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String     @id @default(cuid())
  name        RoleName   @unique
  description String?
  users       UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([bucketKey, windowStart])
}

model McpOAuthClient {
  id                      String                    @id @default(cuid())
  clientId                String                    @unique
  clientSecretHash        String?
  clientName              String?
  redirectUris            String[]
  tokenEndpointAuthMethod String                    @default("none")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  disabledAt              DateTime?
  accessTokens            McpAccessToken[]
  authorizationCodes      McpAuthorizationCode[]
  authorizationRequests   McpAuthorizationRequest[]
  refreshTokens           McpRefreshToken[]

  @@index([disabledAt])
}

model McpAuthorizationRequest {
  id                  String                        @id @default(cuid())
  clientId            String
  redirectUri         String
  clientState         String
  codeChallenge       String
  codeChallengeMethod String
  scope               String
  userId              String?
  status              McpAuthorizationRequestStatus @default(PENDING)
  createdAt           DateTime                      @default(now())
  expiresAt           DateTime
  client              McpOAuthClient                @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model McpAuthorizationCode {
  id                  String         @id @default(cuid())
  codeHash            String         @unique
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  scope               String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime       @default(now())
  client              McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
}

model McpRefreshToken {
  id            String         @id @default(cuid())
  tokenHash     String         @unique
  clientId      String
  userId        String
  scope         McpScope[]
  familyId      String
  rotatedFromId String?
  revokedAt     DateTime?
  expiresAt     DateTime
  lastUsedAt    DateTime?
  createdAt     DateTime       @default(now())
  client        McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model McpAccessToken {
  id         String         @id @default(cuid())
  tokenHash  String         @unique
  clientId   String
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())
  scope      McpScope[]
  client     McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A non-interactive machine credential: an automation, service, or agent with no
/// human user behind it. Unlike McpAccessToken, its scopes are its own (there is no
/// McpUserScopeGrant to intersect against), but it is still individually named,
/// scoped, revocable, and attributable in the audit log.
model AgentToken {
  id          String     @id @default(cuid())
  name        String
  description String?
  tokenHash   String     @unique
  tokenPrefix String
  scope       McpScope[]
  createdBy   String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  lastUsedAt  DateTime?

  @@index([revokedAt])
}

model McpUserScopeGrant {
  id        String    @id @default(cuid())
  userId    String
  scope     McpScope
  grantedAt DateTime  @default(now())
  grantedBy String?
  revokedAt DateTime?
  revokedBy String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope])
  @@index([userId])
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RoleName {
  ADMIN
  STAFF
  VIEWER
}

/// The data scopes an admin can grant. Two neutral examples ship with the template;
/// rename or extend them for the client's domain. Keeping this an enum (rather than a
/// table) means a missed scope check is a compile-time error in every switch over it.
/// Wire names (`data:read`) live in src/lib/server/mcp/scopes.ts.
enum McpScope {
  DATA_READ
  REPORTS_READ
  DOCUMENTS_READ
}

enum McpAuthorizationRequestStatus {
  PENDING
  AWAITING_CONSENT
  GRANTED
  DENIED
  EXPIRED
}

// ---------------------------------------------------------------------------------------
// Documents (docs/decisions/0003-dropbox-document-source.md). Written only by the ingest
// script (`pnpm run documents:ingest`); MCP tools read them. One row per source file, plus
// one row per readable email attachment (parentId set).
// ---------------------------------------------------------------------------------------

enum DocumentKind {
  PDF
  DOCX
  MSG
  KMZ
  OTHER
}

enum DocumentStatus {
  ACTIVE
  REMOVED
}

/// Whether text could be read from the file. NO_TEXT is a PDF with no text layer (scanned;
/// needs OCR). UNSUPPORTED is a file type we do not read. FAILED keeps the reason in
/// `extractionNote` and is retried on the next run only if the file changes or with --force.
enum ExtractionStatus {
  OK
  NO_TEXT
  UNSUPPORTED
  FAILED
}

enum DocumentIngestStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model Document {
  id             String           @id @default(cuid())
  source         String           @default("dropbox")
  /// Dropbox file id (`id:...`). Attachments use `<parent file id>#<n>`.
  sourceFileId   String
  parentId       String?
  parent         Document?        @relation("DocumentAttachments", fields: [parentId], references: [id], onDelete: Cascade)
  attachments    Document[]       @relation("DocumentAttachments")
  /// Path relative to the configured root folder, e.g. `Daily Reports/2026-11-20.pdf`.
  path           String
  /// Folder part of `path` ("" for the root folder).
  folder         String
  name           String
  kind           DocumentKind
  sizeBytes      Int?
  /// Dropbox content_hash; a change means the file content changed.
  contentHash    String?
  modifiedAt     DateTime?
  status         DocumentStatus   @default(ACTIVE)
  extraction     ExtractionStatus
  extractionNote String?
  pageCount      Int              @default(0)
  /// Email headers for MSG files: { subject, from, to, cc, sentAt }.
  meta           Json?
  firstSeenAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  removedAt      DateTime?
  pages          DocumentPage[]
  places         DocumentPlace[]

  @@unique([source, sourceFileId])
  @@index([status, folder])
  @@index([parentId])
}

/// Text of one page (PDF) or one section (other kinds are a single page 1).
model DocumentPage {
  id           String                   @id @default(cuid())
  documentId   String
  document     Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber   Int
  text         String
  /// Generated column (see migration): to_tsvector('english', text). Never written directly.
  searchVector Unsupported("tsvector")?

  @@unique([documentId, pageNumber])
}

/// One placemark from a KMZ/KML file.
model DocumentPlace {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name         String?
  description  String?
  /// KML folder path inside the file, e.g. `Wells/Injectors`.
  kmlFolder    String?
  geometryType String
  /// Representative point: the point itself, or the first vertex of a line/polygon.
  latitude     Float
  longitude    Float
  /// Every vertex as [lon, lat] pairs, for lines and polygons.
  coordinates  Json?

  @@index([documentId])
}

model DocumentIngestRun {
  id         String               @id @default(cuid())
  startedAt  DateTime             @default(now())
  finishedAt DateTime?
  status     DocumentIngestStatus @default(RUNNING)
  force      Boolean              @default(false)
  /// { added, updated, moved, removed, unchanged, failed, attachments }
  counts     Json?
  /// Short, safe failure reason (no file contents, no credentials).
  error      String?

  @@index([status, startedAt])
}
